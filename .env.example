# ── Database / cache (set in docker-compose for local dev) ──
# DATABASE_URL=postgresql://regradar:regradar_pass@db:5432/regradar
# REDIS_URL=redis://redis:6379/0

# ── JWT session signing ─────────────────────────────────────
# REQUIRED. Used to sign/verify dashboard (user) JWT sessions.
# The app fails loudly on startup of any auth flow if this is unset.
# Generate one with:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Optional — JWT session lifetime in days (default 7)
# JWT_EXPIRE_DAYS=7

# ── AI processing ───────────────────────────────────────────
# GOOGLE_API_KEY=
